# Holdet cookie — from a logged-in holdet.dk browser session
HOLDET_COOKIE=your_cookie_here

# Anthropic API key — needed for /gather-intel and odds fallback
ANTHROPIC_API_KEY=your_key_here

# The Odds API key — needed for /gather-odds (free tier: https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here
