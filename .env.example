# Holdet login (used by claude/engine/capture_cookie.py to auto-capture session)
HOLDET_EMAIL=your_email_here
HOLDET_PASSWORD=your_password_here
HOLDET_COOKIE=your_cookie_here     # populated automatically by capture_cookie.py

# Active race dispatch — 'giro' (default) or 'tdf'. See claude/engine/race_config.py.
# Controls which game_id / cartridge / data directory the pipeline reads.
HOLDET_ACTIVE_RACE=giro

# Per-race game IDs and cartridge slugs (race_config.py has fallback defaults).
HOLDET_GAME_ID_GIRO=612
HOLDET_GAME_ID_TDF=618
HOLDET_CARTRIDGE=giro-d-italia-2026
HOLDET_CARTRIDGE_TDF=tour-de-france-2026

# Operator's fantasy team ID for the active race. Distinct per race — register
# a team on the target cartridge first, then capture the ID from the URL.
HOLDET_FANTASY_TEAM_ID=your_team_id_here

# Anthropic API key — needed for /gather-intel and odds fallback
ANTHROPIC_API_KEY=your_key_here

# The Odds API key — needed for /gather-odds (free tier: https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here
